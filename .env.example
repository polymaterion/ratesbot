# Токен бота от @BotFather
BOT_TOKEN=вставьте_токен_бота

# Telegram ID администратора(ов), через запятую.
# Узнать свой ID можно у бота @userinfobot.
ADMIN_IDS=123456789

# Время ежедневной рассылки, формат HH:MM (по Москве)
DAILY_TIME=09:00
TIMEZONE=Europe/Moscow

# Начальный курс TMT за 1 USD при первом запуске.
# После этого курс изменяется командой администратора /tmt_rate 18.
INITIAL_USD_TMT_RATE=3.5

# Путь к базе подписчиков и настроек (по умолчанию рядом с bot.py)
# DB_PATH=subscribers.sqlite3
